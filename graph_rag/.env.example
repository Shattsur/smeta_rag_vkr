# === Paths (относительно корня graph_rag/) ===
# Заполняется по мере реализации графового RAG.
CHUNKS_JSONL=./data/chunks/all_chunks.jsonl

# === Graph storage (пример для Neo4j) ===
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# === Embeddings ===
EMBED_MODEL=deepvk/USER2-base
EMBED_MAX_LENGTH=2048
EMBED_BATCH_SIZE=16

# === LLM ===
LLM_MODEL=saiga_yandexgpt_8b_gguf
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=any
LLM_TEMPERATURE=0.1

# === LangSmith ===
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=smeta-rag-graph
