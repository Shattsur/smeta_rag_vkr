# Общий шаблон переменных для монорепо smeta_rag_project.
# Реальные значения кладутся в gen_rag/.env и graph_rag/.env (они в .gitignore).

# === LLM (общее) ===
LLM_MODEL=saiga_yandexgpt_8b_gguf
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=any
LLM_TEMPERATURE=0.1

# === LangSmith (общее, но project у каждого подпроекта свой) ===
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_PROJECT=smeta-rag-gen    # для gen_rag
# LANGSMITH_PROJECT=smeta-rag-graph  # для graph_rag

# === Hugging Face (если используете push_adapter_to_hf.py) ===
# HF_TOKEN=
