# === Paths (относительно корня gen_rag/) ===
CHROMA_PATH=./chroma_db
CHUNKS_JSONL=./data/chunks/all_chunks.jsonl

# === Embeddings ===
EMBED_MODEL=deepvk/USER2-base
EMBED_MAX_LENGTH=2048
EMBED_BATCH_SIZE=16
# TRUNCATE_DIM: не задавайте — полная размерность эмбеддинга; либо число, напр. 256
# TRUNCATE_DIM=256

# === Retrieval ===
BM25_K=80
VEC_K=100
RRF_K=90
RERANK_THRESHOLD=0.05
FINAL_K=5

# === Reranker ===
RERANK_MODEL=DiTy/cross-encoder-russian-msmarco

# === LLM ===
LLM_MODEL=saiga_yandexgpt_8b_gguf
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=any
LLM_TEMPERATURE=0.1

# === LangSmith ===
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=smeta-rag-gen
